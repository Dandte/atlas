# ═══════════════════════════════════════
# ATLAS — Personal Intelligence System
# Configuration Reference (v1.2)
# ═══════════════════════════════════════

# ── Identity ──
ATLAS_NAME=ATLAS
ATLAS_OWNER=Jose

# ═══════════════════════════════════════
# AI MODELS (at least one required)
# ═══════════════════════════════════════

# Anthropic Claude (primary)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI GPT
OPENAI_API_KEY=
OPENAI_BASE_URL=                              # Leave empty for OpenAI. For compatible APIs: https://api.example.com/v1
OPENAI_MODEL=gpt-4o

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=                       # Leave empty to use OLLAMA_MODEL

# llama.cpp (local)
LLAMACPP_BASE_URL=http://localhost:8080
LLAMACPP_MODEL=

# LM Studio (local)
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL=

# OpenRouter (200+ models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (fast inference)
GROQ_API_KEY=

# Default model prefix: claude, gpt, ollama, gemini, lmstudio, openrouter, llamacpp
DEFAULT_MODEL=claude

# ═══════════════════════════════════════
# CHANNELS
# ═══════════════════════════════════════

# CLI (always available)
CLI_ENABLED=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=                       # Your Telegram chat ID (for owner detection)

# WhatsApp (Baileys)
WHATSAPP_ENABLED=false
WHATSAPP_ALLOWED_NUMBERS=                     # Comma-separated: 573001234567,573009876543
WHATSAPP_OWNER_NUMBER=                        # Your number without +

# WhatsApp Monitor (message tracking)
WHATSAPP_MONITOR_ENABLED=true
WHATSAPP_DOWNLOAD_MEDIA=true
WHATSAPP_DOWNLOAD_IMAGES=true
WHATSAPP_DOWNLOAD_DOCUMENTS=true
WHATSAPP_DOWNLOAD_AUDIO=true
WHATSAPP_DOWNLOAD_VIDEO=false
WHATSAPP_MEDIA_DIR=./data/whatsapp/media
WHATSAPP_IGNORED_CHATS=                       # Comma-separated chat IDs to ignore
WHATSAPP_IN_BRIEFING=true
WHATSAPP_IN_DAILY_SUMMARY=true

# Web Chat (Socket.IO + Neural Interface)
WEB_ENABLED=false
WEB_PORT=3000

# Discord
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_GUILDS=                       # Comma-separated guild/server IDs
DISCORD_OWNER_ID=                             # Your Discord user ID

# Slack
SLACK_ENABLED=false
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_CHANNELS=                       # Comma-separated channel IDs
SLACK_OWNER_ID=                               # Your Slack user ID

# DM Pairing (unknown senders need a code)
DM_PAIRING_ENABLED=false
DM_PAIRING_TTL_MINUTES=60
DM_PAIRING_MAX_PENDING=3

# ═══════════════════════════════════════
# EXTERNAL APIs & INTEGRATIONS
# ═══════════════════════════════════════

# Laravel API (custom REST backend)
LARAVEL_API_URL=
LARAVEL_API_TOKEN=

# MySQL Database
DATABASE_URL=mysql://user:pass@localhost:3306/myapp

# ERP Integration
ERP_ENABLED=false
ERP_COMPANY=default

# ═══════════════════════════════════════
# SEARCH
# ═══════════════════════════════════════

SEARCH_ENGINE=duckduckgo                      # duckduckgo, brave, searxng
BRAVE_SEARCH_API_KEY=
SEARXNG_URL=

# ═══════════════════════════════════════
# MEMORY & CONTEXT
# ═══════════════════════════════════════

CHROMA_URL=http://localhost:8000
MAX_CONTEXT_MESSAGES=40

# Reflection (auto-learning after each interaction)
REFLECTION_ENABLED=true
DEEP_REFLECTION_EVERY=50

# Knowledge Graph
KNOWLEDGE_GRAPH_ENABLED=true

# Session Management
SESSION_TIMEOUT_HOURS=4

# Context Carryover (cross-session)
CONTEXT_CARRYOVER_MESSAGES=5

# ═══════════════════════════════════════
# PERSONALITY & BEHAVIOR
# ═══════════════════════════════════════

EMOTIONAL_ENGINE_ENABLED=true
DEFAULT_PERSONALITY_PROFILE=casual            # casual, formal, technical, creative

# Behavior Engine (proactive intelligence)
BEHAVIOR_ENGINE_ENABLED=true
BEHAVIOR_ANALYSIS_SCHEDULE=0 */6 * * *
BEHAVIOR_MIN_CONFIDENCE=0.6
BEHAVIOR_SUGGESTION_TTL_HOURS=24

# ═══════════════════════════════════════
# NEXUS — Multi-Agent (Phase 7)
# ═══════════════════════════════════════

NEXUS_ENABLED=true
NEXUS_AGENTS=business,sysadmin,developer,researcher,creative,general
NEXUS_AI_ROUTING=true                         # false = keyword/pattern only

# Routing Feedback (learns from corrections)
ROUTING_FEEDBACK_ENABLED=true

# ═══════════════════════════════════════
# SENTINEL — Proactive Engine (Phase 5)
# ═══════════════════════════════════════

# Redis (for BullMQ scheduler, falls back to node-cron)
REDIS_URL=redis://localhost:6379

# Proactivity
MORNING_BRIEFING_HOUR=7
MORNING_BRIEFING_CHANNEL=telegram
DAILY_SUMMARY_HOUR=20
HEALTH_CHECK_INTERVAL=5

# Health Check (remote server monitoring)
HEALTH_CHECK_ENABLED=false
HEALTH_CHECK_SERVERS=                         # name:ip,name:ip
HEALTH_CHECK_URLS=                            # name:url,name:url

# Anomaly Detection
ANOMALY_CHECK_INTERVAL=60
ANOMALY_THRESHOLD=2.0

# Pipelines (multi-step automation)
PIPELINES_ENABLED=true
PIPELINE_MAX_STEPS=20

# Goals Engine
GOALS_ENABLED=true
GOALS_MAX_ACTIVE=10

# ═══════════════════════════════════════
# FORGE — Skill Creation (Phase 6)
# ═══════════════════════════════════════

SANDBOX_TIMEOUT=30000
SANDBOX_MAX_MEMORY=256

# Meta-Learner (auto-analyzes skill performance)
META_LEARNER_ENABLED=true
META_LEARNER_SCHEDULE=0 3 * * *
META_LEARNER_AUTO_CREATE=false
META_LEARNER_MAX_AUTO_CREATIONS=3

# Composable Skills (skills that call other tools)
FORGE_COMPOSABLE_ENABLED=true
FORGE_MAX_CALLTOOL=10
FORGE_COMPOSABLE_TIMEOUT=30000

# Auto-Heal (auto-fix failing skills)
FORGE_AUTO_HEAL=true
FORGE_AUTO_HEAL_MIN_FAILURES=3

# Auto-Rollback (revert bad skill versions)
FORGE_AUTO_ROLLBACK=true
FORGE_ROLLBACK_THRESHOLD=20
FORGE_ROLLBACK_MIN_USES=5

# Plugins
PLUGINS_ENABLED=true

# ═══════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════

REQUIRE_APPROVAL_FOR_SHELL=true
MAX_SHELL_TIMEOUT=30000
BLOCKED_SHELL_COMMANDS=rm -rf /,mkfs,dd if=/dev/zero

# Multi-User
MULTI_USER_ENABLED=false

# ═══════════════════════════════════════
# PRODUCTION
# ═══════════════════════════════════════

# Health Server (Kubernetes/PM2 probes)
HEALTH_SERVER_ENABLED=false
HEALTH_SERVER_PORT=9090

# Dashboard (admin panel)
DASHBOARD_ENABLED=false
DASHBOARD_PORT=4000
DASHBOARD_AUTH=false
DASHBOARD_PASSWORD=

# RAG — Document Intelligence
RAG_ENABLED=false
DOCUMENTS_DIR=
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Backup
BACKUP_ENABLED=false
BACKUP_DIR=
BACKUP_RETAIN_DAYS=14
BACKUP_SCHEDULE=0 2 * * *
BACKUP_COMPRESS=true

# Logging
LOG_LEVEL=info

# A/B Testing
AB_TESTING_ENABLED=false

# Mobile API
MOBILE_API_ENABLED=false

# ═══════════════════════════════════════
# VOICE & TTS
# ═══════════════════════════════════════

VOICE_AUTO_TRANSCRIBE=true
VOICE_AUTO_RESPOND_AUDIO=false
VOICE_TTS_LANGUAGE=es

# STT (Speech-to-Text)
STT_PROVIDER=openai                          # openai, groq

# TTS (Text-to-Speech)
TTS_PROVIDER=openai                          # openai, elevenlabs
TTS_DEFAULT_VOICE=                           # alloy, echo, fable, onyx, nova, shimmer

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ═══════════════════════════════════════
# EMAIL (SMTP + IMAP)
# ═══════════════════════════════════════

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=

# ═══════════════════════════════════════
# HOME AUTOMATION
# ═══════════════════════════════════════

# Tuya / Smart Life
DOMOTICA_ENABLED=false
TUYA_ACCESS_KEY=
TUYA_SECRET_KEY=
TUYA_API_URL=https://openapi.tuyaus.com      # US: tuyaus.com, EU: tuyaeu.com, CN: tuyacn.com
TUYA_DEVICE_ID=                              # Any device ID (for API auth)
DOMOTICA_POLL_INTERVAL=60

# Home Assistant
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# MQTT / IoT
MQTT_BROKER_URL=                             # mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ═══════════════════════════════════════
# INTEGRATIONS (v1.2)
# ═══════════════════════════════════════

# Notion
NOTION_API_KEY=

# Google (Calendar + Sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Twilio (SMS + Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CRM (built-in)
CRM_ENABLED=true

# Financial Tracker
FINANCIAL_ENABLED=true

# Copilot (file watcher)
COPILOT_ENABLED=true

# Cloud Backup
S3_BACKUP_BUCKET=
S3_BACKUP_REGION=us-east-1
S3_BACKUP_ENDPOINT=                          # For S3-compatible (MinIO, etc.)
GDRIVE_BACKUP_FOLDER=ATLAS-Backups

# n8n Workflow Automation
N8N_ENABLED=false
N8N_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_BASE_URL=

# Webhooks (incoming)
WEBHOOK_ENABLED=false
WEBHOOK_PORT=5000

# Browser Agent
BROWSER_AGENT_MAX_STEPS=10

# ═══════════════════════════════════════
# MCP (Model Context Protocol)
# ═══════════════════════════════════════

MCP_SERVER_ENABLED=false
MCP_SERVER_PORT=5050
MCP_SERVERS=                                 # JSON: [{"name":"x","url":"http://..."}]

# ═══ CLAUDE AGENT SDK ═══════════════════
CLAUDE_AGENT_SDK_ENABLED=false               # Enable Claude Code sub-agents as tools
CLAUDE_AGENT_WORK_DIR=                       # Working directory for agents (default: atlas root)
CLAUDE_AGENT_MODEL=claude-sonnet-4-5-20250929  # Model for SDK agents
CLAUDE_AGENT_MAX_TURNS=25                    # Max iterations per agent invocation
