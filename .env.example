# ═══════════════════════════════════════
# ATLAS — Personal Intelligence System
# ═══════════════════════════════════════

# Identidad
ATLAS_NAME=ATLAS
ATLAS_OWNER=Jose

# Modelos (mínimo uno requerido)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=                          # Dejar vacío para OpenAI directo. Para servicios compatibles: https://api.ejemplo.com/v1
OPENAI_MODEL=gpt-4o
OPENROUTER_API_KEY=                       # OpenRouter: 200+ modelos (Claude, Llama, Mistral). Usar con @openrouter
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514  # Ver modelos: openrouter.ai/models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
DEFAULT_MODEL=claude

# Canales
CLI_ENABLED=true

# Telegram
TELEGRAM_BOT_TOKEN=

# WhatsApp
WHATSAPP_ENABLED=false
WHATSAPP_ALLOWED_NUMBERS=

# WhatsApp Monitor (Control Total)
WHATSAPP_MONITOR_ENABLED=true
WHATSAPP_DOWNLOAD_MEDIA=true
WHATSAPP_DOWNLOAD_IMAGES=true
WHATSAPP_DOWNLOAD_DOCUMENTS=true
WHATSAPP_DOWNLOAD_AUDIO=true
WHATSAPP_DOWNLOAD_VIDEO=false
WHATSAPP_MEDIA_DIR=./data/whatsapp/media
WHATSAPP_IGNORED_CHATS=
WHATSAPP_IN_BRIEFING=true
WHATSAPP_IN_DAILY_SUMMARY=true

# Web Chat
WEB_ENABLED=false
WEB_PORT=3000

# APIs externas
LARAVEL_API_URL=
LARAVEL_API_TOKEN=
DATABASE_URL=mysql://user:pass@localhost:3306/gigamovil

# Proactividad
MORNING_BRIEFING_HOUR=7
MORNING_BRIEFING_CHANNEL=telegram
HEALTH_CHECK_INTERVAL=5
DAILY_SUMMARY_HOUR=20

# Seguridad
REQUIRE_APPROVAL_FOR_SHELL=true
MAX_SHELL_TIMEOUT=30000
BLOCKED_SHELL_COMMANDS=rm -rf /,mkfs,dd if=/dev/zero

# Búsqueda web
SEARCH_ENGINE=duckduckgo
BRAVE_SEARCH_API_KEY=
SEARXNG_URL=

# Memoria
CHROMA_URL=http://localhost:8000
MAX_CONTEXT_MESSAGES=40

# Reflexión (Phase 4)
REFLECTION_ENABLED=true
DEEP_REFLECTION_EVERY=50

# Embeddings (Phase 4 — modelo para búsqueda semántica)
# Deja vacío para usar el mismo OLLAMA_MODEL
OLLAMA_EMBEDDING_MODEL=

# ═══════════════════════════════════════
# SENTINEL — Proactividad (Phase 5)
# ═══════════════════════════════════════

# Redis (para BullMQ scheduler)
REDIS_URL=redis://localhost:6379

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_SERVERS=titan:192.168.1.100
HEALTH_CHECK_URLS=MiApp:https://miapp.com/health,API:https://api.miapp.com

# Anomaly Detection
ANOMALY_CHECK_INTERVAL=60
ANOMALY_THRESHOLD=2.0

# ═══════════════════════════════════════
# FORGE — Auto-Evolución (Phase 6)
# ═══════════════════════════════════════

SANDBOX_TIMEOUT=30000
SANDBOX_MAX_MEMORY=256

META_LEARNER_ENABLED=true
META_LEARNER_SCHEDULE=0 3 * * *

# ═══════════════════════════════════════
# NEXUS — Multi-Agente (Phase 7)
# ═══════════════════════════════════════

NEXUS_ENABLED=true

# Agentes habilitados (comma-separated, o "all")
NEXUS_AGENTS=business,sysadmin,developer,researcher,creative,general

# Routing por IA (si false, solo keyword/pattern matching)
NEXUS_AI_ROUTING=true

# Logging
LOG_LEVEL=info
